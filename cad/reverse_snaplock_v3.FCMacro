"""Parametric reconstruction study of one SnapLock V3 latch and mating coupons.

Run in FreeCAD. The source 3MF is read only; organizer models are not changed.
Dimensions are measured from its mesh, not the author's original CAD history.
Output: reverse_snaplock_v3.FCStd. Edit the Parameters spreadsheet, then recompute.
"""
from pathlib import Path
import math

OUTPUT = Path(__file__).resolve().parents[1] / 'reverse_snaplock_v3.FCStd'


def build():
    import FreeCAD as App
    import Part
    import Sketcher

    V = App.Vector
    C = Sketcher.Constraint
    doc = App.newDocument('Reverse_SnapLock_V3')
    settings = doc.addObject('Spreadsheet::Sheet', 'Parameters')
    for row, (alias, value) in enumerate([
        ('Width', '30 mm'), ('Height', '39.964466 mm'), ('Thickness', '10 mm'),
        ('BackThickness', '3 mm'), ('FlexGap', '0.5 mm'),
        ('PivotRadius', '2.5 mm'), ('SocketClearance', '0.2 mm'),
        ('TipRadius', '2.5 mm'), ('TopTipClearance', '0.4 mm'),
        ('TopCatchWidth', '15 mm'), ('TopLeadIn', '0.6 mm'),
        ('HookLeadIn', '0.8 mm'),
        ('UpperFlexWidth', '3.65 mm'), ('UpperFlexGap', '0.5 mm'),
    ], 1):
        settings.set(f'A{row}', alias)
        settings.set(f'B{row}', value)
        settings.setAlias(f'B{row}', alias)
    settings.setColumnWidth('A', 170)
    settings.setColumnWidth('B', 100)
    doc.recompute()

    def sketch(owner, name, plane='XZ', offset=0, origin=None):
        s = owner.newObject('Sketcher::SketchObject', name)
        if plane == 'XZ':
            rotation = App.Rotation(V(1, 0, 0), V(0, 0, 1), V(0, -1, 0), 'ZXY')
            position = V(0, offset, 0)
        elif plane == 'YZ':
            rotation = App.Rotation(V(0, 1, 0), V(0, 0, 1), V(1, 0, 0), 'ZXY')
            position = V(offset, 0, 0)
        else:
            rotation = App.Rotation()
            position = V(0, 0, offset)
        s.Placement = App.Placement(origin if origin is not None else position, rotation)
        return s

    def dimension(s, con, expression=None):
        index = s.addConstraint(con)
        if expression is not None:
            s.setExpression(f'Constraints[{index}]', expression)

    def expression(value, axis):
        parameter, nominal = {'x': ('Width', 30), 'y': ('Thickness', 10),
                              'z': ('Height', 39.964466)}[axis]
        return f'Parameters.{parameter} * ({value / nominal:.12g})'

    def point(s, geometry, endpoint, x, y, axes):
        for kind, value, axis in [('DistanceX', x, axes[0]), ('DistanceY', y, axes[1])]:
            # Zero coordinates use native dimensions without expressions.
            if abs(value) < 1e-10:
                s.addConstraint(C(kind, geometry, endpoint, 0.0))
            else:
                dimension(s, C(kind, geometry, endpoint, value), expression(value, axis))

    def polygon(s, points, axes):
        for a, b in zip(points, points[1:] + points[:1]):
            i = s.addGeometry(Part.LineSegment(V(*a, 0), V(*b, 0)), False)
            point(s, i, 1, *a, axes)
            point(s, i, 2, *b, axes)

    def circle(s, center, radius, axes, radius_expression):
        i = s.addGeometry(Part.Circle(V(*center, 0), V(0, 0, 1), radius), False)
        point(s, i, 3, *center, axes)
        dimension(s, C('Radius', i, radius), radius_expression)

    def finish(owner, s, kind, name, length=None, reversed=False):
        doc.recompute()
        if not s.FullyConstrained or s.solve() != 0:
            raise RuntimeError(f'{s.Name}: sketch is not fully constrained')
        previous = owner.Tip
        f = owner.newObject('PartDesign::'+kind, name)
        f.Profile = s
        if kind in ('Revolution', 'Groove'):
            f.ReferenceAxis = (s, ['H_Axis'])
            f.Angle = 360
        else:
            f.Length = length
            f.Reversed = reversed
        doc.recompute()
        if f.Shape.isNull() or not f.Shape.isValid() or len(f.Shape.Solids) != 1:
            raise RuntimeError(f'{name}: {f.getStatusString()} (invalid or disconnected solid)')
        if previous is not None:
            previous.Visibility = False
        s.Visibility = False
        f.Visibility = True
        return f

    latch = doc.addObject('PartDesign::Body', 'Latch')
    latch.Label = '01 Reconstructed latch — dimensional sketches'
    s = sketch(latch, 'BackOutline', offset=-2)
    # The rear plate carries the thin flexure roots; recesses grow towards +Y.
    polygon(s, [(-15, 0), (15, 0), (15, 40), (8, 40), (8, 35),
                (7.7, 33.5), (6.8, 32.2), (5.5, 31.3), (4, 31),
                (-4, 31), (-5.5, 31.3), (-6.8, 32.2), (-7.7, 33.5),
                (-8, 35), (-8, 40), (-15, 40)], 'xz')
    back = finish(latch, s, 'Pad', 'BackPlate', 3)
    back.setExpression('Length', 'Parameters.BackThickness')

    # Lower arms, with their roots at the bottom of the rear plate.
    for side, label in ((-1, 'Left'), (1, 'Right')):
        s = sketch(latch, label+'LowerArmProfile', 'YZ', side*12 if side > 0 else -15)
        polygon(s, [(-5, 0), (-2, 0), (5, 12.124), (5, 14),
                    (3, 18), (3, 20), (-2, 20), (-5, 21.69)], 'yz')
        finish(latch, s, 'Pad', label+'LowerArm', 3)

        # U-shaped upper arms leave the central finger opening clear.
        s = sketch(latch, label+'UpperArmOutline', offset=5)
        pts = [(side*x, z) for x, z in [(10.75, 20.5), (15, 20.5), (15, 40),
                                        (8, 40), (8, 35), (10.75, 32.25)]]
        polygon(s, pts, 'xz')
        finish(latch, s, 'Pad', label+'UpperArm', 7)

    # This tapered web is distinct from the two flexing side arms.
    s = sketch(latch, 'CentralWebProfile', 'YZ', -3.4)
    polygon(s, [(-2, 0.27), (4.3, 15.4), (3, 18), (-2, 18)], 'yz')
    finish(latch, s, 'Pad', 'CentralWeb', 6.8)
    s = sketch(latch, 'CentralNeckProfile', 'YZ', -1)
    polygon(s, [(-2, 18), (3, 18), (3, 22), (3.946, 23.892), (-2, 30.66)], 'yz')
    finish(latch, s, 'Pad', 'CentralNeck', 2)

    # Global side silhouette: 45-degree upper lead-in and rounded tip envelope.
    s = sketch(latch, 'TopLeadInProfile', 'YZ', -16)
    polygon(s, [(-6, 32.5), (1.8, 40.3), (1.8, 45), (-6, 45)], 'yz')
    finish(latch, s, 'Pocket', 'TopLeadIn', 32, reversed=True)
    for side, label in ((-1, 'Left'), (1, 'Right')):
        s = sketch(latch, label+'UpperArmLeadInProfile', 'YZ', -15.01 if side < 0 else 10.74)
        polygon(s, [(3, 20.49), (5.01, 20.49), (5.01, 26.02), (3, 22)], 'yz')
        finish(latch, s, 'Pocket', label+'UpperArmLeadIn', 4.27, reversed=True)

    # The underside of the finger opening rises from 28.5 at the back to 31 at the recess.
    s = sketch(latch, 'OpeningBackSlopeProfile', 'YZ', -4)
    polygon(s, [(-5.01, 28.49), (-2, 31), (-2, 42), (-5.01, 42)], 'yz')
    finish(latch, s, 'Pocket', 'OpeningBackSlope', 8, reversed=True)

    # Chordal reconstruction of the measured 6 mm corner radii (0.03 mm chord error).
    for side, label in ((-1, 'Left'), (1, 'Right')):
        s = sketch(latch, label+'BottomCornerProfile', offset=5.01)
        arc = [(side*(9+6*math.cos(a)), 6+6*math.sin(a))
               for a in [-math.pi/2 + i*math.pi/16 for i in range(9)]]
        polygon(s, arc + [(side*15, 0)], 'xz')
        finish(latch, s, 'Pocket', label+'BottomCorner', 10.02, reversed=True)

    # Preserve the original lower-pivot flexure slots and transverse reliefs.
    s = sketch(latch, 'FlexureSlotsProfile', offset=5.01)
    for side in (-1, 1):
        polygon(s, [(side*11.5, 6.3), (side*12, 6.3),
                    (side*12, 21.7), (side*11.5, 21.7)], 'xz')
        first = (0 if side == -1 else 4)*4
        for line, endpoint in ((0, 1), (2, 2), (3, 1), (3, 2)):
            index = first+line*4+(endpoint-1)*2
            s.setExpression(f'Constraints[{index}]',
                            f'({side}) * (Parameters.Width * 0.4 - Parameters.FlexGap)')
    finish(latch, s, 'Pocket', 'FlexureSlots', 10.02, reversed=True)
    for side, label in ((-1, 'Left'), (1, 'Right')):
        s = sketch(latch, label+'FlexureReliefProfile', 'YZ', -15.01 if side < 0 else 11.5)
        polygon(s, [(-5.01, 21.69), (-2, 20.59), (0, 20.18), (3, 20),
                    (3, 20.5), (0, 20.68), (-2, 21.11), (-5.01, 22.24)], 'yz')
        finish(latch, s, 'Pocket', label+'FlexureRelief', 3.51, reversed=True)

    # Free the upper hooks from the rear plate, then narrow their lateral bending necks.
    # Upper reliefs are separate from the unchanged lower-pivot slots.
    for side, label in ((-1, 'Left'), (1, 'Right')):
        s = sketch(latch, label+'UpperFlexIsolationProfile', offset=5.01)
        polygon(s, [(side*x, z) for x, z in [
            (10.25, 22.75), (10.75, 22.75), (10.75, 32.25),
            (8, 35), (7.5, 35), (10.25, 32.25)]], 'xz')
        for line, endpoint, base_x in [(0, 1, 10.75), (3, 2, 8),
                                       (4, 1, 8), (4, 2, 10.75),
                                       (5, 1, 10.75), (5, 2, 10.75)]:
            s.setExpression(f'Constraints[{line*4+(endpoint-1)*2}]',
                            f'({side}) * ({base_x} mm - Parameters.UpperFlexGap)')
        finish(latch, s, 'Pocket', label+'UpperFlexIsolation', 10.02, reversed=True)
        s = sketch(latch, label+'UpperFlexNeckProfile', offset=5.01)
        polygon(s, [(side*x, z) for x, z in [
            (15.01, 22.5), (15.01, 35.5), (14.4, 32), (14.4, 24.5)]], 'xz')
        for line, endpoint in [(1, 2), (2, 1), (2, 2), (3, 1)]:
            s.setExpression(f'Constraints[{line*4+(endpoint-1)*2}]',
                            f'({side}) * (10.75 mm + Parameters.UpperFlexWidth)')
        finish(latch, s, 'Pocket', label+'UpperFlexNeck', 10.02, reversed=True)

    def cap(owner, name, center_y, center_z, base_x, tip_x, radius, kind):
        # Measured spherical cap: revolve a sampled meridian, not the source triangles.
        s = sketch(owner, name+'Profile', 'XY', origin=V(0, center_y, center_z))
        center_x = 13.264724735 if base_x > 0 else -13.264724735
        radius_expr = 'Parameters.PivotRadius'+(' + Parameters.SocketClearance' if kind == 'Groove' else '')
        meridian = []
        for step in range(17):
            x = tip_x+(base_x-tip_x)*step/16
            meridian.append((x, math.sqrt(radius**2-(x-center_x)**2)))
        polygon(s, meridian+[(base_x, 0), (tip_x, 0)], 'xy')
        # Radius remains an editable driving expression for every meridian point.
        for line in range(16):
            for endpoint, sample in ((1, line), (2, line+1)):
                x = meridian[sample][0]
                s.setExpression(f'Constraints[{line*4+(endpoint-1)*2+1}]',
                                f'sqrt(({radius_expr})^2 - ({x-center_x} mm)^2)')
        s.setExpression('Constraints[65]', f'sqrt(({radius_expr})^2 - ({base_x-center_x} mm)^2)')
        s.setExpression('Constraints[75]', f'sqrt(({radius_expr})^2 - ({tip_x-center_x} mm)^2)')
        return finish(owner, s, kind, name)

    for side, label in ((-1, 'Left'), (1, 'Right')):
        cap(latch, label+'Pivot', .5, 17.5, side*12, side*10.8, 2.5, 'Revolution')

    # Inward-facing upper tips, separate from the lower ball pivots.
    for side, label in ((-1, 'Left'), (1, 'Right')):
        s = sketch(latch, label+'HookTipProfile', 'YZ', side*6 if side > 0 else -8.2)
        circle(s, (2.5, 37.5), 2.5, 'yz', 'Parameters.TipRadius')
        finish(latch, s, 'Pad', label+'HookTip', 2.2)
    previous = latch.Tip
    edges = [f'Edge{i+1}' for i, edge in enumerate(previous.Shape.Edges)
             if isinstance(edge.Curve, Part.Circle)
             and abs(abs(edge.CenterOfMass.x)-6) < 1e-5
             and abs(edge.CenterOfMass.z-37.5) < 1e-5]
    hook_lead_in = latch.newObject('PartDesign::Chamfer', 'HookLeadIn')
    hook_lead_in.Base = (previous, edges)
    hook_lead_in.Size = 0.8
    hook_lead_in.setExpression('Size', 'Parameters.HookLeadIn')
    doc.recompute()
    if len(edges) != 2 or hook_lead_in.Shape.isNull() or not hook_lead_in.Shape.isValid():
        raise RuntimeError('HookLeadIn: could not chamfer both snap tips')
    previous.Visibility = False

    base = doc.addObject('PartDesign::Body', 'BaseCoupon')
    base.Label = '02 Base mounting coupon — twin spherical sockets'
    s = sketch(base, 'BaseWallProfile', 'YZ', -18)
    polygon(s, [(5, -5), (7, -5), (7, 20), (3, 20), (3, 18), (5, 14)], 'yz')
    finish(base, s, 'Pad', 'BaseWall', 36)
    for side, label in ((-1, 'Left'), (1, 'Right')):
        s = sketch(base, label+'SocketRootProfile', 'YZ', -11.8 if side < 0 else 7.2)
        polygon(s, [(5, 9), (-2, 16), (-2, 20), (5, 20)], 'yz')
        finish(base, s, 'Pad', label+'SocketRoot', 4.6)
        cap(base, label+'Socket', .5, 17.5, side*11.8, side*10.6, 2.7, 'Groove')

    top = doc.addObject('PartDesign::Body', 'TopCoupon')
    top.Label = '03 Top engagement coupon — fork receivers'
    s = sketch(top, 'TopWallProfile', 'YZ', -18)
    polygon(s, [(3, 20), (7, 20), (7, 40), (5, 40), (5, 26), (3, 22)], 'yz')
    finish(top, s, 'Pad', 'TopWall', 36)
    s = sketch(top, 'TopCatchProfile', 'YZ', -7.5)
    s.setExpression('Placement.Base.x', '-Parameters.TopCatchWidth / 2')
    polygon(s, [(5, 26), (5, 30), (2.5, 29.7), (0, 30.1), (-2, 31.15),
                (-2, 37), (5, 44), (7, 45), (7, 37), (5, 35)], 'yz')
    catch = finish(top, s, 'Pad', 'TopCatch', 15)
    catch.setExpression('Length', 'Parameters.TopCatchWidth')
    for side, label in ((-1, 'Left'), (1, 'Right')):
        s = sketch(top, label+'TipReceiverProfile', 'YZ', -7.51 if side < 0 else 4.5)
        s.setExpression('Placement.Base.x', '-Parameters.TopCatchWidth/2 - 0.01 mm' if side < 0
                        else 'Parameters.TopCatchWidth/2 - 3 mm')
        circle(s, (2.5, 37.5), 2.9, 'yz', 'Parameters.TipRadius + Parameters.TopTipClearance')
        finish(top, s, 'Pocket', label+'TipReceiver', 3.01, reversed=True)
    # Relieve the socket mouths instead of forcing a sharp rim over the hook tips.
    previous = top.Tip
    edges = [f'Edge{i+1}' for i, edge in enumerate(previous.Shape.Edges)
             if isinstance(edge.Curve, Part.Circle)
             and abs(abs(edge.CenterOfMass.x)-7.5) < 1e-5]
    lead_in = top.newObject('PartDesign::Chamfer', 'ReceiverLeadIn')
    lead_in.Base = (previous, edges)
    lead_in.Size = 0.6
    lead_in.setExpression('Size', 'Parameters.TopLeadIn')
    doc.recompute()
    if not edges or lead_in.Shape.isNull() or not lead_in.Shape.isValid():
        raise RuntimeError('ReceiverLeadIn: could not chamfer the socket mouths')
    previous.Visibility = False

    for owner, color in [(latch, (.88, .65, .3)), (base, (.35, .6, .8)), (top, (.45, .75, .5))]:
        for obj in owner.Group:
            if hasattr(obj, 'Visibility'):
                obj.Visibility = obj == owner.Tip
        owner.Visibility = True
        if App.GuiUp:
            owner.Tip.ViewObject.ShapeColor = color
    doc.recompute()
    doc.saveAs(str(OUTPUT))
    if App.GuiUp:
        import FreeCADGui as Gui
        Gui.activeDocument().activeView().viewAxonometric()
        Gui.activeDocument().activeView().fitAll()
    print('BUILT:', OUTPUT)
    print('Study model only: compare against source before using this latch in the organizer.')


if __name__ == '__main__':
    build()
